<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- claude-egress-guard: record every connection the pf rules refuse (view with macos/pf/blocked.py) -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.claude-egress-guard.blocklog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Library/Application Support/ClaudeEgressGuard/blocklog.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- 027: blocklog.err and anything else created here is not world-readable -->
  <key>Umask</key>
  <integer>23</integer>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardErrorPath</key>
  <string>/Library/Application Support/ClaudeEgressGuard/blocklog.err</string>
</dict>
</plist>
